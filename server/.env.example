MONGO_URI=your_mongo_connection_string_here

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Store tax as a decimal: 0.08 is 8%. The backend is the checkout source of truth.
TAX_RATE=0.08

# Stripe Checkout allows 30 minutes to 24 hours. Pending orders release stock
# after this window if Stripe has not already sent an expiry event.
CHECKOUT_RESERVATION_MINUTES=30

JWT_SECRET=your_jwt_secret_here

GOOGLE_CLIENT_ID=your_google_client_id

GOOGLE_CLIENT_SECRET=your_google_client_secret

# Comma-separated list of allowed origins for CORS (add your Vercel URL)
CORS_ORIGIN=http://localhost:5173,https://your-vercel-app.vercel.app

# Frontend URL used for Stripe redirect (Vercel URL)
CLIENT_URL=https://your-vercel-app.vercel.app

# NODE_ENV should be 'production' on Render
NODE_ENV=production

# ── Performance Optimization ─────────────────
# Redis URL for API response caching (optional)
# Format: redis://[username:password@]host[:port]
# If not set, caching will be disabled
REDIS_URL=redis://localhost:6379

# CDN URL for static assets (optional)
# Set this in the Vite build for production CDN
# Example: https://cdn.example.com/assets
# CDN_URL=https://cdn.example.com/assets

# ── Request Validation Logging ──────────────
# Enable logging of successful validations (verbose, disabled by default)
LOG_VALIDATION_SUCCESS=false

# Enable logging of validation metrics (periodic stats, disabled by default)
LOG_VALIDATION_METRICS=false

# ── Error Monitoring (Sentry) ────────────────
# Sentry DSN for error tracking and monitoring
# Get DSN from: https://sentry.io
# If not set, error tracking will be disabled
# SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Application version for Sentry release tracking
# APP_VERSION=1.0.0
